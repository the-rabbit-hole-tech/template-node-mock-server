# Local settings for the mock. Copy to .env (git-ignored) and start it with
# `node --env-file=.env bin/mock-server.mjs`.

# The HTTP port, and where to listen (loopback: the controls have no sign-in).
PORT=5180
HOST=127.0.0.1

# Also serve HTTPS, for a client that refuses plain HTTP (an iOS app).
# HTTPS_PORT=5443
# MOCK_TLS_CERT=.certs/server.pem
# MOCK_TLS_KEY=.certs/server-key.pem

# Origins allowed to call with credentials (a web client on another port, no proxy).
# MOCK_CORS_ORIGINS=http://localhost:5173

# Start as a new install, so clients walk first-run setup.
# MOCK_FRESH_INSTALL=1

# Local dev logs everything in human-readable form.
LOG_LEVEL=trace
LOG_FORMAT=console
